NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/finova
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CLIENT_URL=http://localhost:5173
# lax for same-site deploys; "none" for cross-site (e.g. Vercel + separate API host) — forces Secure cookies
COOKIE_SAMESITE=lax
TRUST_PROXY=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Finova <no-reply@finova.local>"
# Document storage. 'local' disk only: use a persistent volume in production (many hosts wipe local disk on deploy).
UPLOAD_DIR=./uploads
# Storage driver for documents: 'local' (disk) or 's3' (any S3-compatible store: AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
